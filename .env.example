# Copy to .env and fill in real values. Never commit the real .env file.
# See docs/DEVELOPMENT_PLAN.md for where each of these comes from.

# --- Core ---
ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,https://ai-liteworld.github.io

# --- Database / cache (spec 9.3) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/marketplace
REDIS_URL=redis://redis:6379/0

# --- LLM provider (Hugging Face Inference Providers, OpenAI-compatible router) ---
# Create a free token at https://huggingface.co/settings/tokens (needs
# "Make calls to Inference Providers" permission).
HF_TOKEN=hf_...
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=https://router.huggingface.co/v1

# --- Storage (spec 6.1) ---
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET_NAME=marketplace-images
CLOUDINARY_URL=cloudinary://...

# --- Frontend (Vite exposes only VITE_-prefixed vars to the browser) ---
# Local dev: leave unset to use the Vite dev-server proxy (see vite.config.ts).
# Production build (GitHub Pages): set to the deployed backend's origin, e.g.
# https://lessmarket-backend.onrender.com (no trailing slash, no /api suffix).
VITE_API_BASE_URL=http://localhost:8000
