# Copy to .env and fill in real values. Never commit the real .env file.
# See docs/DEVELOPMENT_PLAN.md for where each of these comes from.

# --- Core ---
ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string

# --- Database / cache (spec 9.3) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/marketplace
REDIS_URL=redis://redis:6379/0

# --- LLM provider (spec 4, section 2 "LLM Provider") ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Storage (spec 6.1) ---
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET_NAME=marketplace-images
CLOUDINARY_URL=cloudinary://...

# --- Frontend (Vite exposes only VITE_-prefixed vars to the browser) ---
VITE_API_BASE_URL=http://localhost:8000
